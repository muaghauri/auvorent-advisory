CMS_ENV=development
CMS_DATABASE_URL=sqlite:///./instance/auvorent-cms.sqlite
CMS_SESSION_SECURE=false
CMS_SESSION_HOURS=12
CMS_LOGIN_RATE_LIMIT=10
CMS_PUBLIC_ADMIN_ORIGIN=
# Use a fresh unique 32+ character random key in production. Never commit real secrets.
CMS_SECRET_KEY=

# Relative/absolute media path. On a managed host use persistent private storage.
CMS_MEDIA_ROOT=

# Public form origin (the exact website origin); required for cross-origin browser requests.
CMS_PUBLIC_SITE_ORIGIN=http://localhost:8787
CMS_PUBLIC_FORM_RATE_LIMIT=8
# Verify sender domain/address with your mail provider before production delivery.
# No SMTP credentials means inquiries are safely saved but notifications show NOT CONFIGURED.
CMS_SMTP_HOST=
CMS_SMTP_PORT=587
CMS_SMTP_USERNAME=
CMS_SMTP_PASSWORD=
CMS_MAIL_FROM=

# Optional local immutable staging release directory (Phase 5)
CMS_PUBLISH_ROOT=

# Phase 6: origin of the PUBLIC CMS API (for the static V6 JavaScript connector).
# Local development: http://127.0.0.1:8900; production: https://cms.your-verified-domain.example
CMS_PUBLIC_API_BASE=http://127.0.0.1:8900

# Production exports are DISABLED until all gates are explicitly confirmed.
CMS_ENABLE_PRODUCTION_EXPORT=false
CMS_BRAND_CLEARANCE_CONFIRMED=false
CMS_LEGAL_REVIEW_CONFIRMED=false

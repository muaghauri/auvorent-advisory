CMS_ENV=development
CMS_DATABASE_URL=sqlite:///./instance/auvorent-cms.sqlite
CMS_SESSION_SECURE=false
CMS_SESSION_HOURS=12
CMS_LOGIN_RATE_LIMIT=10
CMS_PUBLIC_ADMIN_ORIGIN=
# Use a fresh unique high-entropy key in production. Never commit real secrets.
# Example generation: python -c "import secrets; print(secrets.token_urlsafe(48))"
CMS_SECRET_KEY=

# Relative/absolute media path. On a managed host use persistent private storage.
CMS_MEDIA_ROOT=

# Public form origin (the exact website origin); required for cross-origin browser requests.
CMS_PUBLIC_SITE_ORIGIN=http://localhost:8787
CMS_PUBLIC_FORM_RATE_LIMIT=8

# Preferred production transactional email transport: Resend HTTPS API.
# Store the real API key only in the Railway secret/environment manager.
CMS_RESEND_API_KEY=
CMS_MAIL_FROM=

# Legacy/fallback SMTP configuration. Leave blank when HTTPS API delivery is enabled.
CMS_SMTP_HOST=
CMS_SMTP_PORT=587
CMS_SMTP_USERNAME=
CMS_SMTP_PASSWORD=

# Optional local immutable staging release directory (Phase 5)
CMS_PUBLISH_ROOT=

# Phase 6: origin of the PUBLIC CMS API (for the static V6 JavaScript connector).
# Local development: http://127.0.0.1:8900; production: https://admin.auvorent.com
CMS_PUBLIC_API_BASE=http://127.0.0.1:8900

# Production exports are disabled until explicitly enabled in the protected host environment.
CMS_ENABLE_PRODUCTION_EXPORT=false
CMS_BRAND_CLEARANCE_CONFIRMED=false
CMS_LEGAL_REVIEW_CONFIRMED=false

# Cloudflare Pages deployment credentials. Use a narrowly scoped API token only.
# Never use a Global API Key and never commit real values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=
CLOUDFLARE_API_TOKEN=

# Cloudflare R2 object storage. Real keys belong only in the host secret manager.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_BUCKET=
